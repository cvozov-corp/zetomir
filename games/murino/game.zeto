# Мурино: Туманная война — компактная ZETOMIR-адаптация текстового приключения.
# Правила: say, ask ... as ..., let, when/otherwise, loop, fn, finish.

fn status():
    say ""
    say "ЗДОРОВЬЕ: " + str(health) + " | МОРАЛЬ: " + str(morale) + " | ТУМАН: " + str(fog)
    say ""

fn ending():
    say ""
    say "=== ИТОГ ==="
    when health <= 0:
        say "Туман поглотил тебя. История закончилась здесь."
    otherwise:
        when morale >= 5:
            say "Ты вывел людей из района. Надежда пережила эту ночь."
        otherwise:
            say "Ты выжил, но Мурино запомнит цену твоих решений."
    finish

let health = 10
let morale = 3
let fog = 2
let chapter = 0

say "=========================================="
say "       МУРино: ТУМАННАЯ ВОЙНА"
say "=========================================="
say "2007 год. Район тонет в густом тумане."
say "Ты должен найти пропавшего друга и выбраться."

loop chapter < 4 and health > 0:
    status()
    when chapter == 0:
        say "ГЛАВА 1. ДВОР"
        say "1) Проверить детскую площадку"
        say "2) Пойти к старой проходной"
        ask "Твой выбор: " as choice
        when choice == "1":
            say "На качелях ты находишь записку: 'Иди к станции'."
            morale = morale + 1
        otherwise:
            say "За проходной кто-то хватает тебя за плечо."
            health = health - 2
        fog = fog + 1
    otherwise:
        when chapter == 1:
            say "ГЛАВА 2. ПОДЗЕМНЫЙ ПЕРЕХОД"
            say "1) Помочь незнакомцу"
            say "2) Не останавливаться"
            ask "Твой выбор: " as choice
            when choice == "1":
                say "Незнакомец отдаёт фонарь и показывает короткий путь."
                morale = morale + 2
                fog = fog - 1
            otherwise:
                say "Ты ускоряешь шаг, но теряешь силы."
                health = health - 1
        otherwise:
            when chapter == 2:
                say "ГЛАВА 3. СТАНЦИЯ"
                say "Слышен голос друга из-за закрытой двери."
                say "1) Открыть дверь силой"
                say "2) Позвать на помощь"
                ask "Твой выбор: " as choice
                when choice == "1":
                    say "Дверь поддаётся, но ты ранен осколками."
                    health = health - 2
                otherwise:
                    say "На зов откликаются люди из соседнего подъезда."
                    morale = morale + 1
            otherwise:
                say "ГЛАВА 4. ПОСЛЕДНИЙ ВЫХОД"
                say "Силуэт друга появляется в просвете тумана."
                when morale >= 5:
                    say "Вместе вы выводите остальных к безопасной дороге."
                otherwise:
                    say "Ты находишь друга, но остальные исчезают в тумане."
    chapter = chapter + 1

ending()
